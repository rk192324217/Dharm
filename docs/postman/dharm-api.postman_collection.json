{
  "version": "2.1.0",
  "info": {
    "name": "Dharm API",
    "description": "Dharm food rescue API – WeMakeDevs Environmental Hack 2026.\n\nPhases 1-4 Complete: Users, Matching, Donations, Requests Workflow.\n\nAuth Note: Endpoints are open for testing. Provide `donorId` or `receiverId` in the body where required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/api/health", "host": ["{{BASE_URL}}"], "path": ["api", "health"] }
          }
        }
      ]
    },
    {
      "name": "Users & Organizations",
      "item": [
        {
          "name": "POST /api/users (Create Receiver)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Mumbai Food Bank\",\n  \"role\": \"RECEIVER\",\n  \"organizationName\": \"Mumbai Food Bank Trust\",\n  \"latitude\": 19.076,\n  \"longitude\": 72.877,\n  \"serviceRadiusKm\": 25,\n  \"collectionCapacity\": 500\n}"
            },
            "url": { "raw": "{{BASE_URL}}/api/users", "host": ["{{BASE_URL}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "GET /api/users/{userId}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/api/users/{{receiverId}}", "host": ["{{BASE_URL}}"], "path": ["api", "users", "{{receiverId}}"] }
          }
        },
        {
          "name": "GET /api/organizations/nearby (Proximity)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/organizations/nearby?lat=19.076&lng=72.877&radiusKm=50",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "organizations", "nearby"],
              "query": [
                {"key": "lat", "value": "19.076"},
                {"key": "lng", "value": "72.877"},
                {"key": "radiusKm", "value": "50"}
              ]
            }
          }
        },
        {
          "name": "GET /api/organizations/nearby (Match Mode)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/organizations/nearby?lat=19.076&lng=72.877&donationId={{donationId}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "organizations", "nearby"],
              "query": [
                {"key": "lat", "value": "19.076"},
                {"key": "lng", "value": "72.877"},
                {"key": "donationId", "value": "{{donationId}}"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Donations",
      "item": [
        {
          "name": "POST /api/donations",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donorId\": \"donor-001\",\n  \"title\": \"Leftover biryani\",\n  \"foodCategory\": \"COOKED_MEAL\",\n  \"quantity\": 50,\n  \"unit\": \"servings\",\n  \"preparedAt\": \"2026-10-10T06:00:00Z\",\n  \"pickupDeadline\": \"2026-10-10T22:00:00Z\",\n  \"latitude\": 19.076,\n  \"longitude\": 72.877\n}"
            },
            "url": { "raw": "{{BASE_URL}}/api/donations", "host": ["{{BASE_URL}}"], "path": ["api", "donations"] }
          }
        },
        {
          "name": "GET /api/donations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/api/donations", "host": ["{{BASE_URL}}"], "path": ["api", "donations"] }
          }
        },
        {
          "name": "GET /api/donations/{donationId}",
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/api/donations/{{donationId}}", "host": ["{{BASE_URL}}"], "path": ["api", "donations", "{{donationId}}"] }
          }
        }
      ]
    },
    {
      "name": "Requests Workflow",
      "item": [
        {
          "name": "1. POST request collection",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"{{receiverId}}\",\n  \"requestedQuantity\": 50\n}"
            },
            "url": { "raw": "{{BASE_URL}}/api/donations/{{donationId}}/requests", "host": ["{{BASE_URL}}"], "path": ["api", "donations", "{{donationId}}", "requests"] }
          }
        },
        {
          "name": "2. POST accept request",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donorId\": \"donor-001\"\n}"
            },
            "url": { "raw": "{{BASE_URL}}/api/requests/{{requestId}}/accept", "host": ["{{BASE_URL}}"], "path": ["api", "requests", "{{requestId}}", "accept"] }
          }
        },
        {
          "name": "3. POST mark collected",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"{{receiverId}}\",\n  \"status\": \"COLLECTED\",\n  \"note\": \"Successfully picked up\"\n}"
            },
            "url": { "raw": "{{BASE_URL}}/api/requests/{{requestId}}/status", "host": ["{{BASE_URL}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3000" },
    { "key": "donationId", "value": "set-me" },
    { "key": "receiverId", "value": "set-me" },
    { "key": "requestId", "value": "set-me" }
  ]
}
