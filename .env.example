# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local development. Never commit .env.
# In production these are set as Lambda environment variables via SAM.
# ─────────────────────────────────────────────────────────────────────────────

# Node environment (test | dev | prod)
NODE_ENV=dev

# Application log level (debug | info | warn | error)
LOG_LEVEL=info

# ── DynamoDB Table Names ──────────────────────────────────────────────────────
# When running unit tests these are not used (repositories are mocked).
# When running integration tests against real AWS, set these to your deployed table names.
# Find them in: AWS Console → DynamoDB → Tables  or  sam deploy output
DONATIONS_TABLE=dharm-donations-dev
USERS_TABLE=dharm-users-dev
REQUESTS_TABLE=dharm-requests-dev

# ── AWS Credentials ───────────────────────────────────────────────────────────
# DO NOT put real credentials here. Use:
#   - aws configure  (stores in ~/.aws/credentials)
#   - AWS SSO / IAM Identity Center
#   - Environment variables set by your CI system
#
# AWS_ACCESS_KEY_ID=     ← never here
# AWS_SECRET_ACCESS_KEY= ← never here
# AWS_REGION=ap-south-1
